# Streamlit Community Cloud: paste this (filled in) into
# Manage app -> Settings -> Secrets. Do NOT commit the filled-in version.
# Locally these still come from .env; secrets.toml is the deployed equivalent.

# Either name works (huggingface_hub reads HF_TOKEN, langchain's
# HuggingFaceEndpoint reads HUGGINGFACEHUB_API_TOKEN). Read access is enough
# here; publishing the index needs a write token, but that runs locally.
HF_TOKEN = ""
HF_MODEL = "meta-llama/Llama-3.3-70B-Instruct"

EMBED_MODEL = "embed-v4.0"
EMBED_DIM = "1536"
COHERE_API_KEY = ""
RERANK_MODEL = "rerank-v3.5"
CHROMA_DIR = "chroma_db"
CHROMA_COLLECTION = "compliance"
# Required on Streamlit Cloud: the container has no prebuilt index on disk.
CHROMA_INDEX_REPO = "your-name/compliance-chroma"

RAG_MAX_DISTANCE = "0.62"
RAG_K = "6"
RAG_MAX_INPUT_CHARS = "2000"
LLM_MAX_NEW_TOKENS = "1024"

LANGFUSE_PUBLIC_KEY = ""
LANGFUSE_SECRET_KEY = ""
LANGFUSE_BASE_URL = "https://cloud.langfuse.com"

LANGCHAIN_TRACING_V2 = "false"
LANGCHAIN_API_KEY = ""
LANGCHAIN_PROJECT = "compliance-rag"

# Copy to .env and fill in. config.py loads this via python-dotenv.

# --- LLM provider: "huggingface" | "gemini" | "groq" ---
LLM_PROVIDER=huggingface

# Hugging Face Inference Providers (https://huggingface.co/settings/tokens)
# Token needs the "Make calls to Inference Providers" permission.
HF_TOKEN=
# HUGGINGFACEHUB_API_TOKEN is accepted as an alias throughout — it is the name
# langchain's HuggingFaceEndpoint looks for, so an existing .env may use it.
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
# "auto" routes to whichever backend is serving the model. Pin a named provider
# (e.g. together, fireworks-ai, nebius) to keep ablation latency comparable.
HF_PROVIDER=auto

# --- alternatives, same wrapper ---
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- embeddings (ingest.py / vectorstore.py) ---
# Gemini API key from https://aistudio.google.com/apikey (free tier).
GOOGLE_API_KEY=
# Model and size are recorded on the collection when it is built; the app refuses
# to open an index built with others. Changing either means
# `python ingest.py build --reset`. 3072 is native; 1536 and 768 are smaller.
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=3072
# Free-tier pacing: tokens per minute sent to the embedder. Raise on a paid tier.
EMBED_TPM=30000
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=compliance
# Hugging Face dataset repo holding a prebuilt copy of CHROMA_DIR. Leave unset
# locally: it only exists for hosts that cannot run a 35-minute ingest, where
# vectorstore.ensure_index() downloads the index on first use. Publish a
# rebuild with `python ingest.py push-index <repo_id>`.
# CHROMA_INDEX_REPO=your-name/compliance-chroma

# --- reranking (rag.py) ---
# Cohere reranks the candidates that clear the distance floor. Without a key,
# retrieval falls back to plain vector order. COHERE_API_KEY or CO_API_KEY.
COHERE_API_KEY=
RERANK_MODEL=rerank-v3.5
# false = skip reranking even with a key set (for A/B against vector order).
RAG_RERANK=true

# --- retrieval + guardrails (rag.py) ---
# Cosine DISTANCE floor, so lower is stricter, and the refusal gate: nothing
# above it reaches the reranker or the model. Model-specific — re-measure with
# `python eval_retrieval.py --verbose` after changing EMBED_MODEL.
RAG_MAX_DISTANCE=0.45
# Chunks fetched per question, before the floor filters them.
RAG_K=6
# Questions longer than this are rejected rather than truncated — a truncated
# question is a different question.
RAG_MAX_INPUT_CHARS=2000
# Ceiling on one reply, bounding per-turn cost and runaway generation.
LLM_MAX_NEW_TOKENS=1024

# Show the nearest distance under a "nothing found" reply (floor tuning aid).
RAG_DEBUG=false

# --- observability (observability.py) ---
# Langfuse: one trace per chat turn (retrieve > rerank > LLM), grouped into a
# session per conversation, with 👍/👎 feedback scored onto the trace. Leave the
# keys empty to run without tracing. Keys: Langfuse project > Settings > API keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud by default; https://us.cloud.langfuse.com for US, or your own host.
LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENABLED=false

# LangSmith, alongside Langfuse: the same turn > retrieve > rerank > LLM tree,
# with each chat as one LangSmith thread keyed by its conversation id.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=compliance-rag
# LANGSMITH_* are the current names for the same settings; either prefix works.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=compliance-rag

# Copy to .env and fill in. config.py loads this via python-dotenv.

# --- LLM provider: "huggingface" | "gemini" | "groq" ---
LLM_PROVIDER=huggingface

# Hugging Face Inference Providers (https://huggingface.co/settings/tokens)
# Token needs the "Make calls to Inference Providers" permission.
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
# "auto" routes to whichever backend is serving the model. Pin a named provider
# (e.g. together, fireworks-ai, nebius) to keep ablation latency comparable.
HF_PROVIDER=auto

# --- alternatives, same wrapper ---
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- vector store (ingest.py / vectorstore.py) ---
# Embedding model. Changing this invalidates the index: rebuild with
# `python ingest.py build --reset`. Anything past its token limit is truncated,
# so ingest.py sizes its splitter against EMBED_LIMIT in vectorstore.py.
EMBED_MODEL=BAAI/bge-base-en-v1.5
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=compliance
# Hugging Face dataset repo holding a prebuilt copy of CHROMA_DIR. Leave unset
# locally: it only exists for hosts that cannot run a 35-minute ingest, where
# vectorstore.ensure_index() downloads the index on first use. Publish a
# rebuild with `python ingest.py push-index <repo_id>`.
# CHROMA_INDEX_REPO=your-name/compliance-chroma

# --- retrieval + guardrails (rag.py) ---
# Cosine DISTANCE floor, so lower is stricter. Measured on this corpus: genuine
# hits 0.17-0.31, adjacent-but-unanswerable 0.31-0.39, off-topic 0.50-0.61.
# Nothing above this reaches the model.
RAG_MAX_DISTANCE=0.45
# Chunks fetched per question, before the floor filters them.
RAG_K=6
# Questions longer than this are rejected rather than truncated — a truncated
# question is a different question.
RAG_MAX_INPUT_CHARS=2000
# Ceiling on one reply, bounding per-turn cost and runaway generation.
LLM_MAX_NEW_TOKENS=1024

# --- tracing (Phase 4 onward) ---
# Set to true and fill in the key to send traces to LangSmith. Each chat in the
# Streamlit UI is one LangSmith thread, keyed by its conversation id.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=compliance-rag
# LANGSMITH_* are the current names for the same settings; either prefix works.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=compliance-rag
